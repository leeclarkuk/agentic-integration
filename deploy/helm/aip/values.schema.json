{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "aip chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "edition", "telemetry", "components"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "enum": ["latest"] } },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          }
        },
        "limits": {
          "type": "object",
          "required": ["memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "port", "resources", "autoscaling", "podDisruptionBudget", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 0 },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": { "type": ["integer", "string"] }
          }
        },
        "env": {
          "type": "object",
          "description": "Non-secret environment variables only. Secrets go in connections.existingSecret.",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "not": { "pattern": "(PASSWORD|SECRET|TOKEN|API_KEY|PRIVATE_KEY)" }
          },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageRegistry", "cloud"],
      "properties": {
        "imageRegistry": { "type": "string", "minLength": 1 },
        "imagePullSecrets": { "type": "array" },
        "cloud": { "enum": ["gcp", "aws", "azure", "other"] }
      }
    },
    "edition": { "enum": ["saas", "self-hosted"] },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "endpoint"],
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string", "pattern": "^https://" },
        "installId": {
          "type": "string",
          "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$"
        }
      }
    },
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "existingSecret": { "type": "string" } }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "logLevel": { "enum": ["debug", "info", "warn", "error"] },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "worker"],
      "properties": {
        "api": { "$ref": "#/definitions/component" },
        "worker": { "$ref": "#/definitions/component" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "secretName": { "type": "string" } }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiIngressNamespaces": { "type": "array", "items": { "type": "string" } },
        "egressCIDRs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
