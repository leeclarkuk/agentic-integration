{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "__name__",
  "projectType": "application",
  "sourceRoot": "apps/__name__/src",
  "tags": ["lang:python", "type:service"],
  "targets": {
    "lint": {
      "command": "uv run ruff check apps/__name__ && uv run ruff format --check apps/__name__",
      "cache": true,
      "inputs": ["default"]
    },
    "typecheck": {
      "command": "uv run mypy apps/__name__/src",
      "cache": true,
      "inputs": ["default"]
    },
    "test": {
      "command": "uv run pytest apps/__name__/tests -q",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/uv.lock"]
    }
  }
}
